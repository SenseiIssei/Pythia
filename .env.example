# Pythia backend configuration.
#
#   cp .env.example .env      then fill in your own values
#
# `.env` is gitignored — it never gets committed. The desktop app does NOT use
# this file; it stores keys in the OS keychain (Settings → Alpaca / AI providers).
# NEVER paste real keys into .env.example, screenshots, or chat.

# ── server ───────────────────────────────────────────────────────────────────
PYTHIA_BIND=127.0.0.1:8787
# Optional Discord/webhook URL for fills, exits and risk trips
# PYTHIA_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Alpaca (real equity quotes + live execution) ──────────────────────────────
# Paper keys from https://app.alpaca.markets → API. Paper and live accounts have
# SEPARATE keys — paper keys only work against the paper endpoint, which is what
# the Live page selects by default. Trade permission is enough; no withdrawal.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Live account keys. Alpaca issues a SEPARATE pair per account, and each only
# authenticates against its own endpoint — paper keys sent to api.alpaca.markets
# are a 401, not a fallback. Leave these blank unless you intend to trade real
# money; when blank, the pair above is used for both endpoints.
# APCA_LIVE_API_KEY_ID=
# APCA_LIVE_API_SECRET_KEY=
# Market-data feed: iex = free tier (default), sip = paid subscription
APCA_FEED=iex
# Trade the pre/post-market sessions. Off by default: outside regular hours
# Pythia refuses equity market orders rather than queuing them across an unknown
# overnight gap. With this on it sends whole-share LIMIT orders instead, which is
# what Alpaca accepts for extended hours, and only while Alpaca's own calendar
# says a session is running. This is the default for the opt-in when an arm
# request does not say; the Live page always sends its own toggle.
# PYTHIA_EXTENDED_HOURS=false
# Allow opening SHORT equity positions. Off by default — shorts need a margin
# account, cannot be fractional, and a strategy that happily emits sell signals
# will otherwise collect a wall of broker rejections.
# PYTHIA_ALLOW_SHORTS=false

# ── Crypto exchange (live spot execution) ─────────────────────────────────────
# One exchange at a time — this is where Venue::Crypto routes.
#   kraken | binance | bybit | okx      (coinbase is listed but not wired: it
#                                        signs with ES256 JWTs, see PROFIT-PLAN.md)
# Grant the API key TRADE permission and NOT withdrawal. Then a leaked key costs
# you trades, not coins.
# PYTHIA_EXCHANGE=kraken
# PYTHIA_EXCHANGE_KEY=
# PYTHIA_EXCHANGE_SECRET=
# OKX only — the API passphrase you chose when creating the key.
# PYTHIA_EXCHANGE_PASSPHRASE=

# ── Wallets (watch-only) ──────────────────────────────────────────────────────
# Public addresses to show on the Wallets page. Read-only: Pythia reads the
# native balance and can never spend it. NEVER put a private key or seed phrase
# here — Pythia has no field that accepts one, on purpose.
# Chains: ethereum polygon arbitrum optimism base bsc solana bitcoin
# PYTHIA_WALLETS=[{"chain":"ethereum","address":"0x…","label":"cold"}]

# ── Forecast ensemble sweeps ──────────────────────────────────────────────────
# Automatically ask every configured model about the top markets on a schedule.
# OFF by default: each sweep is one API call per provider per market, and that
# is your money. The Predictions page can always run one on demand.
# PYTHIA_FORECAST_SWEEP_MIN=60
# PYTHIA_FORECAST_SWEEP_MARKETS=3
# Per-provider model override for ensemble runs, e.g.:
# PYTHIA_MODEL_ANTHROPIC=claude-sonnet-5

# ── strategy data & execution ─────────────────────────────────────────────────
# Candle size every indicator runs on. 1Min / 5Min / 15Min / 30Min / 1Hour / 1Day.
# Shorter bars mean more signals, more fees, and less time for an order to reach
# the broker before the edge is gone.
PYTHIA_BAR_TIMEFRAME=5Min
# How far a marketable limit may cross the book, in basis points. Orders go out
# as limits so a thin or gapped book can't fill you at any price; set 0 for plain
# market orders (faster fills, no price protection).
PYTHIA_SLIPPAGE_BPS=25

# ── AI signal providers (all optional — set only what you use) ────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# ZAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# ── AI overlay (background model views; OFF until you enable it in the UI) ─────
# Which provider/model the background overlay polls with. Defaults to Anthropic
# and that provider's current flagship (claude-opus-5).
# PYTHIA_AI_PROVIDER=anthropic
# PYTHIA_AI_MODEL=claude-opus-5
# Thinking depth: low | medium | high | xhigh | max. `low` is the default because
# a signal that arrives after its bar closed is worth nothing.
# PYTHIA_AI_EFFORT=low
# Seconds between calls. One market is polled per pass, round-robin, so this is
# also your cost dial.
# PYTHIA_AI_INTERVAL_SEC=120
