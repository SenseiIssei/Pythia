# Pythia backend configuration.
#
#   cp .env.example .env      then fill in your own values
#
# `.env` is gitignored — it never gets committed. The desktop app does NOT use
# this file; it stores keys in the OS keychain (Settings → Alpaca / AI providers).
# NEVER paste real keys into .env.example, screenshots, or chat.

# ── server ───────────────────────────────────────────────────────────────────
PYTHIA_BIND=127.0.0.1:8787
# Optional Discord/webhook URL for fills, exits and risk trips
# PYTHIA_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Alpaca (real equity quotes + live execution) ──────────────────────────────
# Paper keys from https://app.alpaca.markets → API. Paper and live accounts have
# SEPARATE keys — paper keys only work against the paper endpoint, which is what
# the Live page selects by default. Trade permission is enough; no withdrawal.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Market-data feed: iex = free tier (default), sip = paid subscription
APCA_FEED=iex

# ── strategy data & execution ─────────────────────────────────────────────────
# Candle size every indicator runs on. 1Min / 5Min / 15Min / 30Min / 1Hour / 1Day.
# Shorter bars mean more signals, more fees, and less time for an order to reach
# the broker before the edge is gone.
PYTHIA_BAR_TIMEFRAME=5Min
# How far a marketable limit may cross the book, in basis points. Orders go out
# as limits so a thin or gapped book can't fill you at any price; set 0 for plain
# market orders (faster fills, no price protection).
PYTHIA_SLIPPAGE_BPS=25

# ── AI signal providers (all optional — set only what you use) ────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# ZAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# ── AI overlay (background model views; OFF until you enable it in the UI) ─────
# Which provider/model the background overlay polls with. Defaults to Anthropic
# and that provider's current flagship (claude-opus-5).
# PYTHIA_AI_PROVIDER=anthropic
# PYTHIA_AI_MODEL=claude-opus-5
# Thinking depth: low | medium | high | xhigh | max. `low` is the default because
# a signal that arrives after its bar closed is worth nothing.
# PYTHIA_AI_EFFORT=low
# Seconds between calls. One market is polled per pass, round-robin, so this is
# also your cost dial.
# PYTHIA_AI_INTERVAL_SEC=120
