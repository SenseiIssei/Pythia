# Normalize line endings: repo stores LF, Windows checkouts get CRLF where natural.
* text=auto eol=lf

# Binary assets — never touch.
*.png binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary

# Frozen, pre-registered model files are checked by their sha256: never convert them.
research/lab/lab/models/frozen/*.txt binary
